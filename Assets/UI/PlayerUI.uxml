<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/PlayerUI.uss"/>
    <ui:VisualElement name="HealthBar" picking-mode="Ignore" class="hudHealth">
        <ui:VisualElement name="BarBackground" picking-mode="Ignore" class="hudHealthBack">
            <ui:VisualElement name="BarProgress" picking-mode="Ignore" class="hudHealthFill"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="BottomLeft" picking-mode="Ignore" class="hudBottomLeft">
        <ui:VisualElement name="AmmoBar" picking-mode="Ignore" class="hudAmmo"/>
        <ui:VisualElement name="BlockIndicator" picking-mode="Ignore" class="hudBlock">
            <ui:VisualElement name="BlockFill" picking-mode="Ignore" class="hudBlockFill"/>
            <ui:Label name="BlockKey" picking-mode="Ignore" class="hudBlockKey" text="RMB"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="Points" picking-mode="Ignore" class="hudPoints">
        <ui:VisualElement name="Player1" picking-mode="Ignore" class="hudPlayerRow">
            <ui:VisualElement name="PointBackground" picking-mode="Ignore" class="hudPointSlot">
                <ui:VisualElement name="Point" picking-mode="Ignore" class="hudPoint hudPoint--red" style="display: none;"/>
            </ui:VisualElement>
            <ui:VisualElement name="PointBackground" picking-mode="Ignore" class="hudPointSlot">
                <ui:VisualElement name="Point" picking-mode="Ignore" class="hudPoint hudPoint--red" style="display: none;"/>
            </ui:VisualElement>
            <ui:VisualElement name="PointBackground" picking-mode="Ignore" class="hudPointSlot">
                <ui:VisualElement name="Point" picking-mode="Ignore" class="hudPoint hudPoint--red" style="display: none;"/>
            </ui:VisualElement>
            <ui:VisualElement name="PointBackground" picking-mode="Ignore" class="hudPointSlot">
                <ui:VisualElement name="Point" picking-mode="Ignore" class="hudPoint hudPoint--red" style="display: none;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Player2" picking-mode="Ignore" class="hudPlayerRow hudPlayerRow--second">
            <ui:VisualElement name="PointBackground" picking-mode="Ignore" class="hudPointSlot">
                <ui:VisualElement name="Point" picking-mode="Ignore" class="hudPoint hudPoint--blue" style="display: none;"/>
            </ui:VisualElement>
            <ui:VisualElement name="PointBackground" picking-mode="Ignore" class="hudPointSlot">
                <ui:VisualElement name="Point" picking-mode="Ignore" class="hudPoint hudPoint--blue" style="display: none;"/>
            </ui:VisualElement>
            <ui:VisualElement name="PointBackground" picking-mode="Ignore" class="hudPointSlot">
                <ui:VisualElement name="Point" picking-mode="Ignore" class="hudPoint hudPoint--blue" style="display: none;"/>
            </ui:VisualElement>
            <ui:VisualElement name="PointBackground" picking-mode="Ignore" class="hudPointSlot">
                <ui:VisualElement name="Point" picking-mode="Ignore" class="hudPoint hudPoint--blue" style="display: none;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
