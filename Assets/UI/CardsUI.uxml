<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/CardButton.uss?fileID=7433441132597879392&amp;guid=d8a0bc54fa5d35641b06997a98023f98&amp;type=3#CardButton"/>
    <ui:VisualElement class="cards-ui-root" style="width: 100%; height: 100%; flex-direction: row; background-color: rgba(12, 6, 28, 0);">
        <ui:VisualElement name="CardsHeader" picking-mode="Ignore" style="position: absolute; left: 0; right: 0; top: 11%; height: 12%; flex-direction: row; align-items: center; justify-content: center;">
            <ui:Label text="RED" name="PlayerColorLabel" class="cards-header-label" style="margin-right: 28px; color: rgb(255, 32, 0);"/>
            <ui:Label text="Is Choosing..." name="IsChoosing" class="cards-header-label"/>
        </ui:VisualElement>
        <ui:VisualElement name="CardRow" picking-mode="Ignore" class="cards-row">
            <ui:Button text="" name="Card1" class="CardButton">
                <ui:Label name="Mark" text="?" picking-mode="Ignore" class="card-back-mark"/>
                <ui:VisualElement name="Info" class="card-info" style="display: none;"/>
            </ui:Button>
            <ui:Button text="" name="Card2" class="CardButton card-tilt-right">
                <ui:Label name="Mark" text="?" picking-mode="Ignore" class="card-back-mark"/>
                <ui:VisualElement name="Info" class="card-info" style="display: none;"/>
            </ui:Button>
            <ui:Button text="" name="Card3" class="CardButton">
                <ui:Label name="Mark" text="?" picking-mode="Ignore" class="card-back-mark"/>
                <ui:VisualElement name="Info" class="card-info" style="display: none;"/>
            </ui:Button>
            <ui:Button text="" name="Card4" class="CardButton card-tilt-right">
                <ui:Label name="Mark" text="?" picking-mode="Ignore" class="card-back-mark"/>
                <ui:VisualElement name="Info" class="card-info" style="display: none;"/>
            </ui:Button>
            <ui:Button text="" name="Card5" class="CardButton">
                <ui:Label name="Mark" text="?" picking-mode="Ignore" class="card-back-mark"/>
                <ui:VisualElement name="Info" class="card-info" style="display: none;"/>
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
