<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/TextFieldBorder.uss?fileID=7433441132597879392&amp;guid=592bedcd4e4b46c4a86a12c9f5e95477&amp;type=3#TextFieldBorder"/>
    <Style src="project://database/Assets/UI/MenuButtons.uss?fileID=7433441132597879392&amp;guid=2ab9714e0b7d59945878b8c4c03f4af2&amp;type=3#MenuButtons"/>
    <ui:VisualElement name="MainMenu" style="flex-grow: 1; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; display: flex;">
        <ui:VisualElement name="TitleGroup" picking-mode="Ignore" style="position: absolute; left: 5%; top: 4%; rotate: -4deg; transform-origin: left center;">
            <ui:Label text="Outwobbled" name="TitleExtrusion" picking-mode="Ignore" style="position: absolute; left: 0; top: 0; translate: 0 12px; -unity-font-definition: url(&quot;project://database/Assets/UI/Fonts/VarsityTeam-Bold.otf?fileID=12800000&amp;guid=d17a1f7ca61d45645aed92c3fcd5f57b&amp;type=3#VarsityTeam-Bold&quot;); font-size: 110px; -unity-text-outline-width: 10px; -unity-text-outline-color: rgb(0, 0, 0); color: rgb(110, 30, 0); letter-spacing: 8px; white-space: nowrap;"/>
            <ui:Label text="Outwobbled" name="Title" picking-mode="Ignore" style="-unity-font-definition: url(&quot;project://database/Assets/UI/Fonts/VarsityTeam-Bold.otf?fileID=12800000&amp;guid=d17a1f7ca61d45645aed92c3fcd5f57b&amp;type=3#VarsityTeam-Bold&quot;); font-size: 110px; -unity-text-outline-width: 10px; -unity-text-outline-color: rgb(0, 0, 0); color: rgb(255, 170, 20); letter-spacing: 8px; white-space: nowrap; text-shadow: 0 -4px 0 rgb(255, 225, 120);"/>
        </ui:VisualElement>
        <ui:Button text="Create Lobby" name="CreateLobby" class="menuButton" style="width: 20%; height: 10%; top: 72%; left: 4%;"/>
        <ui:Button text="Join Lobby" name="JoinLobby" class="menuButton" style="width: 20%; height: 10%; top: 74%; left: 4%;"/>
        <ui:TextField label="" name="LobbyCodeInput" class="menuInput" placeholder-text="Enter Code..." hide-placeholder-on-focus="true" max-length="6" style="left: 26%; width: 16%; top: 65%; height: 8%;"/>
    </ui:VisualElement>
    <ui:VisualElement name="WaitingRoom" style="flex-grow: 1; display: none; align-items: center;">
        <ui:Button text="Start Game" name="StartGame" class="menuButton" style="width: 20%; height: 10%; top: 65%; left: 0%;"/>
        <ui:Button text="Leave Lobby" name="LeaveLobby" class="menuButton menuButtonSmall" style="width: 16%; height: 8%; top: 67%; left: 0%;"/>
        <ui:Button text="Invite Friends" name="InviteFriends" class="menuButton menuButtonSmall" style="display: none; width: 18%; height: 8%; top: 69%; left: 0%;"/>
        <ui:Label text="" name="LobbyCode" enable-rich-text="true" style="position: absolute; right: 3%; bottom: 4%; -unity-font-definition: url(&quot;project://database/Assets/UI/Fonts/VarsityTeam-Bold.otf?fileID=12800000&amp;guid=d17a1f7ca61d45645aed92c3fcd5f57b&amp;type=3#VarsityTeam-Bold&quot;); font-size: 22px; color: rgb(255, 255, 255); -unity-text-align: middle-center; white-space: normal; letter-spacing: 4px; padding-top: 14px; padding-bottom: 16px; padding-left: 36px; padding-right: 36px; background-color: rgba(18, 18, 22, 0.88); border-top-width: 3px; border-right-width: 3px; border-bottom-width: 3px; border-left-width: 3px; border-top-color: rgb(238, 131, 26); border-right-color: rgb(238, 131, 26); border-bottom-color: rgb(238, 131, 26); border-left-color: rgb(238, 131, 26); border-top-left-radius: 14px; border-top-right-radius: 14px; border-bottom-right-radius: 14px; border-bottom-left-radius: 14px; -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(0, 0, 0);"/>
    </ui:VisualElement>
</ui:UXML>
